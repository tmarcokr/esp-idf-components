{
    // --- ESP-IDF extension -----------------------------------------------------
    // Project-level only. Machine-specific paths (ESP-IDF, tools, Python env,
    // serial port) belong in the user settings managed by the extension.
    // This repository is a multi-example library: every example under
    // `examples/` is a standalone ESP-IDF project with its own `build/`.
    // Open the example folder (e.g. `code examples/07_smart_led`) to build,
    // flash and debug it with the extension; the OpenOCD board config
    // (`idf.openOcdConfigs`) is written by "ESP-IDF: Set Espressif Device
    // Target", so it follows the selected chip (ESP32-S3 or ESP32-C6).

    // --- clangd (esp-clang) ----------------------------------------------------
    // `esp-clangd` is a stable symlink to the esp-clang clangd, created by the
    // dotfiles ESP32 setup script (the real path carries the tool version).
    // The compilation database is resolved per file by `.clangd`, not here.
    "clangd.path": "${env:HOME}/.local/bin/esp-clangd",
    "clangd.arguments": [
        "--query-driver=**/xtensa-esp*-elf-*,**/riscv32-esp*-elf-*",
        "--header-insertion=never"
    ],
    // clangd owns diagnostics and completion; keep Microsoft IntelliSense off
    // in case cpptools gets installed as a dependency of another extension.
    "C_Cpp.intelliSenseEngine": "disabled",

    // --- Workspace ---------------------------------------------------------------
    "git.ignoredRepositories": [
        "${workspaceFolder}/managed_components"
    ],
    "files.exclude": {
        "**/managed_components": true,
        "**/build": true
    },
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 500,
    "diffEditor.renderSideBySide": true,
    "diffEditor.useInlineViewWhenSpaceIsLimited": false,
    "editor.mouseWheelZoom": true,
    "workbench.editorAssociations": {
        "*.md": "vscode.markdown.preview.editor"
    }
}
